# Opciones del Compose raíz. Credenciales de aplicaciones locales: docker/postgres/init.sql.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
KAFKA_PORT=9092
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8080

# Para ejecutar desde el IDE, exportar estas variables al proceso (Spring no lee .env).
# En contenedores, Compose utiliza postgres:5432 y kafka:29092.
ORDER_DB_URL=jdbc:postgresql://localhost:5432/orderflow_orders
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ORDER_INVENTORY_COMMANDS_TOPIC=order.inventory.commands
INVENTORY_ORDER_EVENTS_TOPIC=inventory.order.events
ORDER_PAYMENT_COMMANDS_TOPIC=order.payment.commands
PAYMENT_ORDER_EVENTS_TOPIC=payment.order.events
ORDER_EVENTS_TOPIC=order.events
