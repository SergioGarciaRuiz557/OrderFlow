### ============================================================================
### 7. Order por Kafka: los cinco eventos de entrada y todas sus transiciones
### ============================================================================
# Requisitos: Order y Kafka activos; DETENGA Inventory y Payment para evitar que los comandos que
# publica Order compitan con la inyección manual. Arranque Order con topics de salida desechables
# (por ejemplo ORDER_INVENTORY_COMMANDS_TOPIC=manual.order.inventory.commands y
# ORDER_PAYMENT_COMMANDS_TOPIC=manual.order.payment.commands) o elimine el broker antes de reactivar
# esos servicios: de otro modo consumirán después los comandos pendientes de estos pedidos manuales.
# Notification puede permanecer activo. Respete estrictamente el orden de cada flujo.

### 7A. InventoryReservedEvent -> AuthorizePaymentCommand -> PaymentAuthorizedEvent -> CONFIRMED

# @name kafkaOrderSuccessPreparePendingOrder
POST {{orderBaseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerId": "{{$uuid}}",
  "items": [
    {
      "productId": "HTTP-MANUAL-ORDER-SUCCESS",
      "quantity": 2,
      "unitPrice": 30.00
    }
  ],
  "paymentMethodId": "pm-test-success"
}

> {%
  client.test("Se prepara el pedido pendiente de inventario", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(response.body.status === "INVENTORY_RESERVATION_PENDING", "Estado inicial inesperado");
  });
  client.global.set("manualSuccessOrderId", response.body.orderId);
%}

###

# Order solo usa orderId, pero se envía el contrato canónico completo.
# @name kafkaOrderInjectInventoryReserved
< {%
  const orderId = client.global.get("manualSuccessOrderId");
  if (!orderId) throw new Error("Ejecute kafkaOrderSuccessPreparePendingOrder primero");
  const value = {
    messageId: $random.uuid,
    messageType: "InventoryReservedEvent",
    correlationId: orderId,
    causationId: $random.uuid,
    aggregateId: orderId,
    occurredAt: $isoTimestamp,
    version: 1,
    payload: {
      orderId: orderId,
      reservationId: $random.uuid,
      reservedItems: [{ productId: "HTTP-MANUAL-ORDER-SUCCESS", quantity: 2 }]
    }
  };
  request.variables.set("recordKey64", btoa(orderId));
  request.variables.set("recordValue64", btoa(JSON.stringify(value)));
%}
POST {{kafkaRestBaseUrl}}/topics/{{inventoryEventsTopic}}
Content-Type: application/vnd.kafka.binary.v2+json
Accept: application/vnd.kafka.v2+json

{
  "records": [
    { "key": "{{recordKey64}}", "value": "{{recordValue64}}" }
  ]
}

> {%
  client.test("Kafka acepta InventoryReservedEvent", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.offsets[0].error_code === null, "Kafka no escribió el registro");
  });
%}

