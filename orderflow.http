# OrderFlow - pruebas manuales completas
#
# Cliente objetivo: HTTP Client de IntelliJ IDEA 2026.1 o posterior; los bloques usan scripts JS,
# btoa/atob y sleep.
# NO use "Run All Requests": este archivo contiene escenarios alternativos, errores deliberados y
# mensajes venenosos. Ejecute, en orden, solo los bloques del escenario que quiera comprobar.
#
# Superficies públicas reales del proyecto:
#   - order-service:     POST /api/orders, GET /api/orders/{orderId}
#   - inventory-service: PUT /api/inventory/{productId}, GET /api/inventory/{productId}
#   - payment-service:   sin HTTP; entrada/salida exclusivamente por Kafka
#   - notification-service: sin HTTP; entrada exclusivamente por Kafka
# Los eventos de dominio internos de Order (OrderCreated, InventoryReservationRequested, etc.) no son
# contratos públicos ni tienen adaptador de entrada; los diez mensajes Kafka públicos sí están aquí.
#
# Kafka usa el protocolo binario en :9092, no HTTP. Para que las peticiones de eventos de este archivo
# sean ejecutables, compose.yaml ofrece un REST Proxy opcional en :8082:
#   docker compose --profile manual-testing up -d --wait
#
# Order necesita además su PostgreSQL independiente:
#   docker compose -f order-service/compose.yaml up -d --wait
#
# Payment no tiene compose propio. Antes de arrancarlo, proporcione una base PostgreSQL "payment"
# y configure DB_URL/DB_USERNAME/DB_PASSWORD. Inventory usa por defecto localhost:5432 y Order :5433.
#
# Arranque cada aplicación desde su directorio con gradlew.bat bootRun. Para el flujo E2E deben estar
# activos Order, Inventory, Payment y Notification, además de sus bases de datos y Kafka.
#
# Las peticiones Kafka se envían en el formato binary v2 del REST Proxy. Los scripts codifican la clave
# y el JSON a Base64 para reproducir exactamente StringSerializer/StringDeserializer. Una respuesta 200
# del proxy confirma la escritura en Kafka, no el procesamiento de negocio; compruébelo con los GET,
# los logs o el consumidor observador incluido más abajo.

@orderBaseUrl = http://localhost:8081
@inventoryBaseUrl = http://localhost:8080
@kafkaRestBaseUrl = http://localhost:8082

@inventoryCommandsTopic = order.inventory.commands
@inventoryEventsTopic = inventory.order.events
@paymentCommandsTopic = order.payment.commands
@paymentEventsTopic = payment.order.events
@orderEventsTopic = order.events

@happyProduct = HTTP-HAPPY-001
@noStockProduct = HTTP-NO-STOCK-001
@rejectedPaymentProduct = HTTP-PAYMENT-REJECTED-001
@unsupportedPaymentProduct = HTTP-PAYMENT-UNSUPPORTED-001
@technicalPaymentProduct = HTTP-PAYMENT-ERROR-001
@rollbackFirstProduct = HTTP-ROLLBACK-FIRST-001
@rollbackMissingProduct = HTTP-ROLLBACK-MISSING-001
@manualInventoryProduct = HTTP-MANUAL-INVENTORY-001

@missingOrderId = 00000000-0000-0000-0000-000000000404


### ============================================================================
### 0. Infraestructura Kafka HTTP
### ============================================================================

# @name kafkaListTopics
GET {{kafkaRestBaseUrl}}/topics
Accept: application/vnd.kafka.v2+json

> {%
  client.test("Kafka REST Proxy responde", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200 del REST Proxy");
  });
%}


