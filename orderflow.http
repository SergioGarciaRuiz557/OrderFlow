### ============================================================================
### 9. Contratos Kafka inválidos / mensajes venenosos - EJECUTAR SIEMPRE AL FINAL
### ============================================================================
# El proyecto no tiene DLT, retry topics ni deduplicación genérica. Estos registros están diseñados
# para hacer fallar listeners y pueden reintentarse o bloquear el avance de su partición/grupo.
# Use una base/broker desechable o topics/grupos sobrescritos para pruebas negativas aisladas.
#
# Mutaciones que todos los listeners rechazan y que puede aplicar a los cuerpos siguientes:
#   - messageId/correlationId/aggregateId/causationId no UUID
#   - ausencia del campo causationId (null sí es válido)
#   - occurredAt no parseable como Instant
#   - version distinta de 1
#   - messageType no soportado por ese topic
#   - payload ausente/no objeto
#   - aggregateId o correlationId distintos de payload.orderId
#
# Inventory además rechaza items vacío, productId vacío y quantity <= 0.
# Payment además rechaza amount negativo o con más de 2 decimales exactos, currency != EUR y
# paymentMethodId vacío. Notification exige payload.customerId UUID.

# JSON truncado: Payment registra "Malformed Kafka JSON" y no produce ningún evento.
# @name kafkaDangerMalformedPaymentJson
< {%
  request.variables.set("recordKey64", btoa("99000000-0000-0000-0000-000000000001"));
  request.variables.set("recordValue64", btoa('{"messageId":'));
%}
POST {{kafkaRestBaseUrl}}/topics/{{paymentCommandsTopic}}
Content-Type: application/vnd.kafka.binary.v2+json
Accept: application/vnd.kafka.v2+json

{
  "records": [
    { "key": "{{recordKey64}}", "value": "{{recordValue64}}" }
  ]
}

> {%
  client.test("Kafka almacena el JSON venenoso", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200 del proxy");
    client.assert(response.body.offsets[0].error_code === null, "Kafka no escribió el registro");
  });
%}

###

