### ============================================================================
### 3. Flujos E2E: los cuatro microservicios activos
### ============================================================================

### 3A. Éxito: reserva -> pago autorizado -> confirmación -> notificación

# @name e2eSuccessSetStock
PUT {{inventoryBaseUrl}}/api/inventory/{{happyProduct}}
Content-Type: application/json
Accept: application/json

{
  "quantity": 10
}

###

# @name e2eSuccessCreateOrder
POST {{orderBaseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerId": "{{$uuid}}",
  "items": [
    {
      "productId": "{{happyProduct}}",
      "quantity": 2,
      "unitPrice": 59.99
    }
  ],
  "paymentMethodId": "pm-test-success"
}

> {%
  client.test("Se crea el pedido E2E satisfactorio", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(Number(response.body.total) === 119.98, "Total inesperado");
  });
  client.global.set("e2eSuccessOrderId", response.body.orderId);
%}

###

# Espera a que Kafka complete el flujo. Si la máquina arranca en frío, vuelva a ejecutar el GET.
# @name e2eSuccessGetFinalOrder
< {% await sleep(3000); %}
GET {{orderBaseUrl}}/api/orders/{{e2eSuccessOrderId}}
Accept: application/json

> {%
  client.test("El pedido termina confirmado", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.status === "CONFIRMED", "Se esperaba CONFIRMED; vuelva a consultar si el flujo sigue en curso");
  });
%}

###

# @name e2eSuccessGetInventory
GET {{inventoryBaseUrl}}/api/inventory/{{happyProduct}}
Accept: application/json

> {%
  client.test("El flujo exitoso conserva la reserva activa", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.availableQuantity === 8, "Se esperaba stock 8");
    client.assert(response.body.reservations.some(r => r.orderId === client.global.get("e2eSuccessOrderId") && r.status === "ACTIVE"), "No aparece la reserva activa");
  });
%}


