### 2. Todos los endpoints REST de Order y sus errores de transporte
### ============================================================================

# Este POST también inicia el flujo distribuido si Kafka está habilitado.
# @name orderCreateBasic
POST {{orderBaseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerId": "{{$uuid}}",
  "items": [
    {
      "productId": "{{happyProduct}}",
      "quantity": 1,
      "unitPrice": 12.34
    }
  ],
  "paymentMethodId": "pm-test-success"
}

> {%
  client.test("Order crea un pedido", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(response.headers.valueOf("Location") !== null, "Falta Location");
    client.assert(response.body.orderId !== undefined, "Falta orderId");
    client.assert(response.body.status === "INVENTORY_RESERVATION_PENDING", "Estado inicial inesperado");
    client.assert(Number(response.body.total) === 12.34, "Total inesperado");
    client.assert(response.body.currency === "EUR", "Divisa inesperada");
  });
  client.global.set("basicOrderId", response.body.orderId);
%}

###

