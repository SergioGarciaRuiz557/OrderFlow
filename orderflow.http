### ============================================================================
### 4. Observador Kafka no intrusivo (REST Proxy v2)
### ============================================================================
# Cree el observador antes de publicar mensajes si quiere ver solo una ejecución limpia. El grupo es
# único y no roba registros a los microservicios. El poll decodifica claves/valores String desde Base64.

# @name kafkaObserverCreate
< {%
  const suffix = $random.uuid.replaceAll("-", "");
  const group = `orderflow-http-${suffix}`;
  const instance = `observer-${suffix}`;
  request.variables.set("observerGroup", group);
  request.variables.set("observerInstance", instance);
  client.global.set("observerGroup", group);
  client.global.set("observerInstance", instance);
%}
POST {{kafkaRestBaseUrl}}/consumers/{{observerGroup}}
Content-Type: application/vnd.kafka.v2+json
Accept: application/vnd.kafka.v2+json

{
  "name": "{{observerInstance}}",
  "format": "binary",
  "auto.offset.reset": "earliest",
  "auto.commit.enable": "false"
}

> {%
  client.test("Se crea el observador Kafka", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.base_uri !== undefined, "Falta base_uri");
  });
  client.global.set("observerBaseUri", response.body.base_uri);
%}

###

# @name kafkaObserverSubscribeAllTopics
POST {{observerBaseUri}}/subscription
Content-Type: application/vnd.kafka.v2+json
Accept: application/vnd.kafka.v2+json

{
  "topics": [
    "{{inventoryCommandsTopic}}",
    "{{inventoryEventsTopic}}",
    "{{paymentCommandsTopic}}",
    "{{paymentEventsTopic}}",
    "{{orderEventsTopic}}"
  ]
}

> {%
  client.test("El observador queda suscrito", function () {
    client.assert(response.status === 204, "Se esperaba HTTP 204");
  });
%}

###

# Ejecute varias veces: un poll vacío es normal. La salida decodificada aparece en Response Handler.
# @name kafkaObserverPollAndDecode
GET {{observerBaseUri}}/records?timeout=5000&max_bytes=1048576
Accept: application/vnd.kafka.binary.v2+json

> {%
  client.test("El poll Kafka es válido", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body), "Se esperaba un array de registros");
  });
  for (const record of response.body) {
    const key = record.key === null ? null : atob(record.key);
    const rawValue = record.value === null ? null : atob(record.value);
    let value = rawValue;
    try { value = rawValue === null ? null : JSON.parse(rawValue); } catch (_) { }
    client.log(JSON.stringify({
      topic: record.topic,
      partition: record.partition,
      offset: record.offset,
      key: key,
      value: value
    }, null, 2));
  }
%}

###

# @name kafkaObserverDelete
DELETE {{observerBaseUri}}
Content-Type: application/vnd.kafka.v2+json
Accept: application/vnd.kafka.v2+json

> {%
  client.test("Se elimina el observador Kafka", function () {
    client.assert(response.status === 204, "Se esperaba HTTP 204");
  });
%}


### ============================================================================
### 5. Inventory por Kafka: todos los comandos y resultados de negocio
### ============================================================================
# Requisitos: Inventory y Kafka activos. Detenga Order mientras use UUID sintéticos; de lo contrario,
# Order recibirá los eventos resultantes para pedidos que no existen en su base de datos. Antes de
# volver a arrancar Order, descarte el broker de pruebas o ejecute Inventory con
# INVENTORY_ORDER_EVENTS_TOPIC=manual.inventory.order.events y adapte la variable de topic del archivo.
# Reinicie la base de Inventory o cambie los UUID/productos si quiere repetir el escenario desde cero.

# @name kafkaInventoryPrepareStock
PUT {{inventoryBaseUrl}}/api/inventory/{{manualInventoryProduct}}
Content-Type: application/json
Accept: application/json

{
  "quantity": 5
}

###

# Produce ReserveInventoryCommand. Resultado esperado en inventory.order.events:
# InventoryReservedEvent; stock 5 -> 3.
# @name kafkaInventoryReserve
< {%
  const orderId = "71000000-0000-0000-0000-000000000001";
  const value = {
    messageId: $random.uuid,
    messageType: "ReserveInventoryCommand",
    correlationId: orderId,
    causationId: null,
    aggregateId: orderId,
    occurredAt: $isoTimestamp,
    version: 1,
    payload: {
      orderId: orderId,
      items: [{ productId: "HTTP-MANUAL-INVENTORY-001", quantity: 2 }]
    }
  };
  request.variables.set("recordKey64", btoa(orderId));
